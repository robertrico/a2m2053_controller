.DS_Store
build/
*.uf2
*.elf
*.bin
!firmware/test/fixtures/*.bin
__pycache__/
.venv/

# third-party docs: local only, never in history (see docs/SOURCES.md)
docs/private/*
!docs/private/.gitkeep

# editor state
.obsidian/

# private build-documentation script (Claude reads it, git never does)
CLAUDE.local.md

.superpowers/

firmware/build/
firmware/test/build/

# raw scope waveforms (MBs each): local only
docs/captures/**/*.csv

# routing scratch (Freerouting DSN/SES, DRC dumps, helper scripts): local only
hardware/kicad/scratch/*
!hardware/kicad/scratch/.gitkeep

# Freerouting exchange files (derived)
hardware/*.dsn
hardware/*.ses
hardware/*.rules
hardware/export/

# vendor 3D models (third party, see docs/SOURCES.md): local only
hardware/kicad/3d/

# personal workflow notes (resume order, order numbers, bench state): local only
HANDOFF.md
