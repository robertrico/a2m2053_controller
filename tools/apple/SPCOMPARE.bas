10 REM SPCOMPARE: SMARTPORT CALLS TO SLOT 5 UNIT 1 (M7 ORACLE)
15 REM CALLER AT $300: JSR SMARTPORT, CMD, PARMS AT $310, STA $30F, RTS. BUFFER $4000.
20 D = 50432 + PEEK (50687) + 3:B = 16384:U = 1
30 FOR I = 0 TO 9: READ X: POKE 768 + I,X: NEXT
40 POKE 769,D - INT (D / 256) * 256: POKE 770, INT (D / 256)
50 DATA 32,0,0,0,16,3,141,15,3,96
60 PRINT "SPCOMPARE S5 U";U;" ENTRY ";D
70 S = 0:N = 4: GOSUB 500
80 S = 3:N = 25: GOSUB 500
90 S = 5:N = 8: GOSUB 500
100 S = 1:N = 0: GOSUB 500
110 FOR K = 0 TO 2:BL = K: GOSUB 600: NEXT
120 BL = 1600: GOSUB 600
130 END
500 REM STATUS CODE S, SHOW N BYTES
510 POKE 771,0: POKE 784,3: POKE 785,U: POKE 786,0: POKE 787,B / 256: POKE 788,S
520 FOR I = 0 TO 31: POKE B + I,0: NEXT
530 CALL 768:E = PEEK (783)
540 PRINT "ST";S;" E=";:H = E: GOSUB 900: PRINT ":";
550 IF N > 0 THEN FOR I = 0 TO N - 1:H = PEEK (B + I): GOSUB 900: NEXT
560 PRINT : RETURN
600 REM READBLOCK BL: FIRST 8 BYTES AND A SUM
610 POKE 771,1: POKE 784,3: POKE 785,U: POKE 786,0: POKE 787,B / 256
620 POKE 788,BL - INT (BL / 256) * 256: POKE 789, INT (BL / 256): POKE 790,0
630 FOR I = 0 TO 7: POKE B + I,0: NEXT
640 CALL 768:E = PEEK (783):SM = 0
650 IF E = 0 THEN FOR I = 0 TO 511:SM = SM + PEEK (B + I): NEXT
660 PRINT "RB";BL;" E=";:H = E: GOSUB 900: PRINT ":";
670 FOR I = 0 TO 7:H = PEEK (B + I): GOSUB 900: NEXT
680 PRINT " S=";SM: RETURN
900 REM PRINT H AS TWO HEX DIGITS
910 H$ = "0123456789ABCDEF": PRINT MID$ (H$, INT (H / 16) + 1,1); MID$ (H$,H - INT (H / 16) * 16 + 1,1);
920 RETURN
