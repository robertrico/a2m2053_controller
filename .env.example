# Local tool paths for this repo. Copy to .env.local (git-ignored) and edit.
# The firmware Makefile and the tools/apple scripts read .env.local. A value
# already set in your shell environment, or given on the make command line,
# wins over this file. Paths must not contain spaces.

# Pico SDK 2.2.0 checkout (required to build the firmware).
PICO_SDK_PATH=/path/to/pico-sdk

# OpenOCD with RP2350 support, e.g. Raspberry Pi's build from pico-sdk-tools.
# Default: openocd on PATH.
#OPENOCD=/path/to/openocd

# GDB for `make gdb`. Default: arm-none-eabi-gdb on PATH.
#GDB=arm-none-eabi-gdb

# AppleCommander jar (https://applecommander.github.io/), for tools/apple/*.sh.
AC_JAR=/path/to/AppleCommander-ac-13.0.jar

# An 800K ProDOS image to take the boot blocks, PRODOS and BASIC.SYSTEM from,
# for tools/apple/*.sh. ProDOS 2.4.x from https://prodos8.com works.
PRODOS_SRC=/path/to/ProDOS_2_4_1.po
